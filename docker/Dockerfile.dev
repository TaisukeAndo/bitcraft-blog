# ローカル開発専用イメージ。
#
# Cloudflare Workersの本番デプロイはこのコンテナ配信ではなく、CIから
# `wrangler deploy` で行うエッジデプロイのため（.github/workflows/deploy.yml参照）、
# このDockerfileは「Node/pnpm/wranglerを誰の開発機でも同一に再現する」用途に限定する。
FROM node:22-bookworm-slim

# リポジトリの package.json に固定した pnpm バージョンを corepack 経由で有効化する。
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

WORKDIR /app

# 依存関係のインストールは docker-compose.yml 側の install サービスが担当する
# （リポジトリ全体をbind mountする構成のため、ここでCOPY・RUN pnpm installしても
# bind mountに上書きされてしまい意味がない）。
# wranglerはグローバルインストールせず、各app配下のdevDependency経由（pnpm exec /
# pnpm run経由）で呼び出す前提。

EXPOSE 8787 8788 8789

CMD ["sleep", "infinity"]
