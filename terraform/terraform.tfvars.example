# terraform.tfvars.example
#
# コピーして terraform.tfvars を作り、実際の値を記入する。
# terraform.tfvars 自体は .gitignore 対象（CIからは TF_VAR_account_id 環境変数で
# 渡すため、terraform.tfvars はローカルでの terraform plan/apply 確認用にのみ使う）。

account_id = "your-cloudflare-account-id"

# 既定値は "bitcraft.work"。通常は変更不要。
# zone_name = "bitcraft.work"
