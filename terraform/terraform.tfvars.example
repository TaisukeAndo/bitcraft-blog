# terraform.tfvars.example
#
# コピーして terraform.tfvars を作り、実際の値を記入する。
# terraform.tfvars 自体は .gitignore 対象ではないため、account_id のような
# 機微情報を直書きしない場合は commit しないこと（本リポジトリでは
# CI からは TF_VAR_account_id 環境変数で渡すため、terraform.tfvars は
# ローカルでの terraform plan/apply 確認用にのみ使う想定）。

account_id = "your-cloudflare-account-id"

# 既定値は "bitcraft.work"。通常は変更不要。
# zone_name = "bitcraft.work"
