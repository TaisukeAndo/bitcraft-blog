{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bitcraft-blog-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bitcraft-blog",
      "database_id": "e242bd88-3ec4-4b2c-8073-9e3b662f6f9c",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "bitcraft-blog-media"
    }
  ]
  // Custom Domain (blog-api.bitcraft.work) は terraform/workers.tf
  // （実装プラン10章）で最初から接続する。bitcraft-siteのようなPhase 8までの
  // 段階カットオーバーは不要（実装プラン1章）。
}
